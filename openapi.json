  "info": {
    "title": "PlayVerse Node",
    "description": "PlayVerse Node api description",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "HTTP (Localhost)"
    },
    {
      "url": "/3339",
      "description": "HTTPS"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": "string",
            "example": "Rajesh Kumar",
            "description": "Display name of user"
          },
          "country_code": {
            "type": "string",
            "example": "+91",
            "description": "Country code of a user"
          },
          "mobile_number": {
            "type": "string",
            "example": "9876543210",
            "description": "Phone number of a user"
          },
          "role": {
            "type": "string",
            "example": "PLAYER",
            "description": "Role of the user",
            "enum": [
              "PLAYER",
              "GROUND_OWNER",
              "ORGANIZER",
              "ADMIN"
            ],
            "default": "PLAYER"
          },
          "profile_image": {
            "type": "string",
            "example": "https://example.com/profiles/rajesh.jpg",
            "description": "Profile image url of user"
          },
          "auth_type": {
            "type": "string",
            "example": "Local",
            "description": "Auth type of user. Local/Social media type"
          },
          "app_type": {
            "type": "string",
            "example": "App",
            "description": "App type. App or Browser"
          },
          "os": {
            "type": "string",
            "example": "Android",
            "description": "Device os type"
          },
          "brand": {
            "type": "string",
            "example": "Samsung A50",
            "description": "Device brand name"
          },
          "model_no": {
            "type": "string",
            "example": "SM-A12E",
            "description": "Device model number"
          },
          "serial_number": {
            "type": "string",
            "example": "SA4545as45a4",
            "description": "Device serial number"
          },
          "version_number": {
            "type": "string",
            "example": "1.0",
            "description": "version number"
          },
          "fcm_token": {
            "type": "string",
            "example": "fcm_token_001",
            "description": "FCM token of the device"
          }
        },
        "required": [
          "display_name",
          "country_code",
          "mobile_number",
          "role",
          "auth_type",
          "app_type",
          "os",
          "brand",
          "model_no",
          "serial_number",
          "version_number"
        ]
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {
          "mobile_number": {
            "type": "string",
            "example": "9876543210",
            "description": "Phone number of a user"
          },
          "country_code": {
            "type": "string",
            "example": "+91",
            "description": "Country code of a user"
          },
          "app_type": {
            "type": "string",
            "example": "App",
            "description": "Login type of user."
          },
          "os": {
            "type": "string",
            "example": "Android",
            "description": "Device os type"
          },
          "brand": {
            "type": "string",
            "example": "Samsung A50",
            "description": "Device brand name"
          },
          "model_no": {
            "type": "string",
            "example": "SM-A12E",
            "description": "Device model number"
          },
          "serial_number": {
            "type": "string",
            "example": "SA4545as45a4",
            "description": "Device serial number"
          },
          "version_number": {
            "type": "string",
            "example": "1.0",
            "description": "version number"
          },
          "fcm_token": {
            "type": "string",
            "example": "fcm_token_001",
            "description": "FCM token of the device"
          }
        },
        "required": [
          "mobile_number",
          "country_code",
          "app_type",
          "os",
          "brand",
