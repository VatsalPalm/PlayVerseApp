    "/api/grounds/v1/{id}/availability": {
      "get": {
        "operationId": "GroundController_getAvailability",
        "summary": "Get available time slots for a ground on a specific date",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "date",
            "required": true,
            "in": "query",
            "description": "Date to check availability (YYYY-MM-DD)",
            "example": "2026-08-01",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sportId",
            "required": false,
            "in": "query",
            "description": "Filter by sport ID to verify the ground supports this sport",
            "example": 1,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available slots"
          },
          "400": {
            "description": "Ground does not support the requested sport"
          },
          "404": {
            "description": "Ground not found"
          }
        },
        "tags": [
          "Grounds"
        ]
      }
    },
