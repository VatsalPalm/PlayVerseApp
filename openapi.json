          }
        },
        "tags": [
          "Grounds"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "get": {
        "operationId": "GroundController_getPublicGrounds",
        "summary": "Public ground listing with search, city, sport, price & geo-radius filters",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number",
            "example": 1,
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Records per page",
            "example": 10,
            "schema": {
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Search by ground name or city",
            "example": "arena",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "required": false,
            "in": "query",
            "description": "Filter by city",
            "example": "Ahmedabad",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sportId",
            "required": false,
            "in": "query",
            "description": "Filter by sport ID",
            "example": 1,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "priceFrom",
            "required": false,
            "in": "query",
            "description": "Minimum slot price filter",
            "example": 100,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "priceTo",
            "required": false,
            "in": "query",
            "description": "Maximum slot price filter",
            "example": 1000,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "latitude",
            "required": false,
            "in": "query",
            "description": "User latitude for geo-radius search",
            "example": 23.032,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "longitude",
            "required": false,
            "in": "query",
            "description": "User longitude for geo-radius search",
            "example": 72.521,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius",
            "required": false,
            "in": "query",
            "description": "Search radius in km (requires latitude & longitude). Default: 5 km",
            "example": 5,
            "schema": {
              "default": 5,
              "type": "number"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Sort field",
            "example": "created_at",
            "schema": {
              "default": "created_at",
              "type": "string"
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "description": "Sort order",
            "schema": {
              "default": "DESC",
              "enum": [
                "ASC",
                "DESC"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of public grounds"
          }
        },
        "tags": [
          "Grounds"
        ]
      }
    },
