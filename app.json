{
  "expo": {
    "name": "PlayVerse",
    "slug": "playverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#000211"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.playverse",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyDY1UU7ewuL9EK2zemNvtzZoLx_9epbqIg"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow PlayVerse to use your location to find nearby matches.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow PlayVerse to use your location to find nearby matches.",
        "NSLocationAlwaysUsageDescription": "Allow PlayVerse to use your location to find nearby matches."
      }
    },
    "android": {
      "package": "com.playverse",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDY1UU7ewuL9EK2zemNvtzZoLx_9epbqIg"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging"
    ]
  }
}
